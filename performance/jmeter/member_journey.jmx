            <stringProp name="RegexExtractor.regex">"recruiter_id":"([^"]+)"</stringProp>
            <stringProp name="RegexExtractor.template">$1$</stringProp>
            <stringProp name="RegexExtractor.default">NO_ID</stringProp>
            <stringProp name="RegexExtractor.match_no">1</stringProp>
